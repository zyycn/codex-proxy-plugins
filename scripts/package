#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
plugin_target="${1:-$(rustc -vV | awk '/^host: / {print $2}')}"
plugin_cli="${PLUGIN_CLI:-cpr-plugin}"
if ! command -v "$plugin_cli" >/dev/null 2>&1; then
  echo '未找到插件 CLI，请按 README 安装或通过 PLUGIN_CLI 指定可执行文件' >&2
  exit 1
fi
case "$plugin_target" in
  x86_64-unknown-linux-gnu|aarch64-unknown-linux-gnu|aarch64-apple-darwin) ;;
  *) echo "不支持的插件目标平台：$plugin_target" >&2; exit 1 ;;
esac
package_example() {
  local example="$1"
  local binary="$2"
  pnpm --dir "examples/$example/frontend" build
  cargo build --release --locked --target "$plugin_target" --manifest-path "examples/$example/backend/Cargo.toml"
  "$plugin_cli" package \
    --manifest "examples/$example/plugin.json" \
    --binary "examples/$example/backend/target/$plugin_target/release/$binary" \
    --target "$plugin_target" \
    --resource-map web=frontend/dist \
    --output-dir dist
}

package_example workbench codex-proxy-plugin-workbench
