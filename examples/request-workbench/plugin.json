{
  "manifestVersion": 2,
  "name": "request-workbench",
  "displayName": "Request Workbench",
  "publisher": "codex-proxy",
  "version": "0.1.0",
  "description": "Demonstrates a scoped response marker and a local management page.",
  "license": "Apache-2.0",
  "author": "codex-proxy-rs contributors",
  "engines": {
    "codex-proxy-rs": ">=3.13.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "middleware": {
      "id": "codex-proxy.request-workbench.middleware",
      "version": 1,
      "stages": [
        "request"
      ],
      "inputFormats": [
        "openai"
      ],
      "outputFormats": [
        "openai"
      ]
    },
    "management": {
      "id": "codex-proxy.request-workbench.management",
      "version": 1,
      "stages": [
        "management"
      ],
      "inputFormats": [],
      "outputFormats": []
    }
  },
  "permissions": [
    "response_headers_write"
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "headerValue": {
        "type": "string",
        "title": "Response marker",
        "description": "Value appended to the x-cpr-example response header.",
        "default": "official-example",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[!-~](?:[ -~]*[!-~])?$"
      }
    },
    "additionalProperties": false
  },
  "icon": "assets/icon.png",
  "resources": {
    "LICENSE": "text/plain",
    "assets/icon.png": "image/png",
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  }
}
